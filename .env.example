# =====================================================================
# Trading Lab — variables d'environnement
# Copier vers .env puis renseigner les secrets :  cp .env.example .env
# NE JAMAIS commiter le fichier .env
# =====================================================================

# --- PostgreSQL (conteneur trading-lab-postgres, NON exposé) ---
POSTGRES_USER=tradinglab
POSTGRES_PASSWORD=change-me-generate-strong
POSTGRES_DB=tradinglab

# --- Backend ---
# Doit reprendre le même user/password/db que ci-dessus.
# IMPORTANT : host = trading-lab-postgres (nom de conteneur unique). Le nom court
# "postgres" est ambigu : le projet tikeayiti a aussi un service "postgres" et le
# backend est branché sur les deux réseaux -> le DNS Docker peut renvoyer le mauvais.
DATABASE_URL=postgresql+psycopg://tradinglab:change-me-generate-strong@trading-lab-postgres:5432/tradinglab
LOG_LEVEL=INFO
# Kill switch manuel du paper trading (phase 6) : false = aucune nouvelle position
TRADING_ENABLED=true

# --- Market data (phase 1) ---
MARKET_DATA_PROVIDER=binance
MARKET_DATA_API_KEY=
MARKET_DATA_SYMBOLS=BTC/USDT,ETH/USDT
MARKET_DATA_TIMEFRAMES=1h,4h,1d
# API publique Binance (données marché uniquement, sans clé).
# data-api.binance.vision = endpoint officiel sans géo-restriction.
# Repli possible : https://api.binance.com (peut renvoyer HTTP 451 selon l'IP du VPS).
BINANCE_BASE_URL=https://data-api.binance.vision

# --- Stratégie démo (phase 3) ---
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
RSI_BUY=50
RSI_SELL=50

# --- Risk management (phase 7) ---
INITIAL_CAPITAL=1000
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.10
# --- Paper trading : OFF par défaut, activation explicite via POST /api/paper/start ---
PAPER_TRADING_ENABLED=false
